  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "tablefmt": "./bin/tablefmt.js"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "table",
    "terminal",
    "cli",
    "ansi",
    "unicode",
    "wrap",
    "csv",
    "markdown"
  ],
  "license": "MIT"
}
